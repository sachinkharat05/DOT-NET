@{
    ViewData["Title"] = "Checkout";
    var totalAmount = ViewBag.TotalAmount ?? 0;
}

<h2>Checkout</h2>
<hr />

<div>
    <a asp-controller="Cart" asp-action="Index">Back to Cart</a> |
    <a asp-controller="Customers" asp-action="Dashboard">Back to Dashboard</a>
</div>

<h3>Order Summary</h3>
<table border="1" cellpadding="8" width="100%" style="margin-top:10px;">
    <tr>
        <td><b>Total Amount</b></td>
        <td>₹@totalAmount</td>
    </tr>
    <tr>
        <td><b>Delivery Charges</b></td>
        <td>₹200</td>
    </tr>
    <tr>
        <td><b>Grand Total</b></td>
        <td><b>₹@(Convert.ToDecimal(totalAmount) + 200)</b></td>
    </tr>
</table>

<h3>Customer Details</h3>
<form method="post">
    <div>
        <label>Name:</label><br />
        <input type="text" name="name" style="width:250px;" />
    </div>
    <div style="margin-top:10px;">
        <label>Address:</label><br />
        <textarea name="address" rows="4" style="width:250px;"></textarea>
    </div>
    <div style="margin-top:10px;">
        <label>Payment Method:</label><br />
        <select name="paymentMethod" style="width:250px;">
            <option value="Cash on Delivery">Cash on Delivery</option>
            <option value="Card">Card</option>
            <option value="UPI">UPI</option>
        </select>
    </div>
    <div style="margin-top:15px;">
        <button type="submit">Place Order</button>
    </div>
</form>
