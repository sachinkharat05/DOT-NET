@model List<ECommercePortal.Models.Student>

@{ ViewData["Title"] = "Students"; }

<h2>Student List</h2>
<p> <a asp-action="Create">Add New Student</a> </p>

<table border="1" cellpadding="8">

    <tr>
        <th>Id</th>  <th>First Name</th> <th>Last Name</th> <th>Email</th> <th>Actions</th>
    </tr>

    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.FirstName</td>
            <td>@student.LastName</td>
            <td>@student.Email</td>

            <td>
                <a asp-action="Details" asp-route-id="@student.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@student.Id">Delete</a>
            </td>
        </tr>
    }
</table>
