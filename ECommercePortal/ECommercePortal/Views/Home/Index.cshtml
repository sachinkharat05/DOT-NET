@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome  to @ViewBag.CompanyName</h1>
    @{
        List<string> names=new List<string>();
        names.Add("Sachin");
        names.Add("Nitish"); 
        names.Add("Karan");
        names.Add("Ajay");

       foreach(string name in names){
            <p> @name</p>
        }
    }
</div>

